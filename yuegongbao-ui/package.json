{
  "name": "yuegongbao-ui",
  "version": "3.9.2",
  "description": "YueGongBao admin frontend based on Vue 3",
  "author": "YueGongBao Team",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "fnm exec --using 20.20.2 node ./node_modules/vite/bin/vite.js --mode ygb-dev",
    "dev:ygb": "fnm exec --using 20.20.2 node ./node_modules/vite/bin/vite.js --mode ygb-dev",
    "dev:azb": "fnm exec --using 20.20.2 node ./node_modules/vite/bin/vite.js --mode azb-dev",
    "build:prod": "fnm exec --using 20.20.2 node ./node_modules/vite/bin/vite.js build --mode ygb",
    "build:ygb": "fnm exec --using 20.20.2 node ./node_modules/vite/bin/vite.js build --mode ygb",
    "build:azb": "fnm exec --using 20.20.2 node ./node_modules/vite/bin/vite.js build --mode azb",
    "build:stage": "fnm exec --using 20.20.2 node ./node_modules/vite/bin/vite.js build --mode staging",
    "preview": "fnm exec --using 20.20.2 node ./node_modules/vite/bin/vite.js preview",
    "verify:role-portal": "fnm exec --using 20.20.2 node ./scripts/verify-role-portal-alignment.mjs",
    "verify:dual-portal-delivery": "fnm exec --using 20.20.2 node ./scripts/verify-dual-portal-delivery.mjs",
    "verify:portal-aggregation-contract": "fnm exec --using 20.20.2 node ./scripts/verify-portal-aggregation-contract.mjs",
    "verify:portal-runtime-behavior": "fnm exec --using 20.20.2 node ./scripts/verify-portal-runtime-behavior.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@vueup/vue-quill": "1.2.0",
    "@vueuse/core": "14.1.0",
    "axios": "1.13.2",
    "clipboard": "2.0.11",
    "echarts": "5.6.0",
    "element-plus": "2.13.1",
    "file-saver": "2.0.5",
    "fuse.js": "7.1.0",
    "js-beautify": "1.15.4",
    "js-cookie": "3.0.5",
    "jsencrypt": "3.3.2",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "vue": "3.5.26",
    "vue-cropper": "1.1.1",
    "vue-router": "4.6.4",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "sass-embedded": "1.97.2",
    "unplugin-auto-import": "0.18.6",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "6.4.1",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-svg-icons": "2.0.1"
  },
  "overrides": {
    "quill": "2.0.2"
  },
  "resolutions": {
    "quill": "2.0.2"
  }
}
